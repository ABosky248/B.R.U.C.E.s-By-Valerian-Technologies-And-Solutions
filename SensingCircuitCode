const int sensorPin = A0; //Connect pressure sensor output 
const int outPin = 9;

float sensVal = 0; //Current sensor value 
float preSensVal = 0; //Previous sensor value 
bool initialized = false; //Make sure it starts off

const float alpha = 0.1;
const float slopeThresh = 0.01; //How much the signal needs to change by to read as rise or fall

void setup() {
  pinMode(outPin, OUTPUT);
}

void loop() {
  int raw = analogRead(sensorPin); //Read the output of the sensor

  sensVal = alpha * raw + (1 - alpha) * sensVal;

  float slope = sensVal - preSensVal;

  if (slope > slopeThresh) {
    digitalWrite(outPin, HIGH);
  } else if (slope < -slopeThresh) {
    digitalWrite(outPin, LOW);
  }

  preSensVal = sensVal;

  delay(10);
}
