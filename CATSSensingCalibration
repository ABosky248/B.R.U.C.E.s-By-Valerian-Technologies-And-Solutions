#include <TimerOne.h>

const int sensorPin = A0;
const int outPin = 9;

float sensVal = 0.0;
float preSensVal = 0.0;
const float alpha = 0.01;

const unsigned long NO_FLOW_TIME_MS = 30000UL;
const unsigned long CPAP_TIME_MS    = 60000UL;

unsigned long phaseStartTime = 0;
int phase = 0; // 0=no-flow, 1=cpap, 2=done

float noFlowMax = 0.0;
float flowMin = 1e9;
float riseSum = 0.0;
int riseCount = 0;
bool inBreath = false;

void setup() {
  Serial.begin(9600);
  while (!Serial) delay(10);

  pinMode(outPin, OUTPUT);
  digitalWrite(outPin, LOW);

  Timer1.initialize(50000);
  Timer1.attachInterrupt(pulseISR);
  Timer1.stop();

  Serial.println(F("Calibration: 30s NO CPAP, then 60s CPAP ON"));
  Serial.println(F("Press any key to start..."));
  while (!Serial.available()) delay(50);
  Serial.read();

  phase = 0;
  phaseStartTime = millis();
  sensVal = 0.0;
  preSensVal = 0.0;
  noFlowMax = 0.0;
  flowMin = 1e9;
  riseSum = 0.0;
  riseCount = 0;
  inBreath = false;

  Serial.println(F(">>> NO CPAP (30s)"));
}

void loop() {
  unsigned long now = millis();
  unsigned long el = now - phaseStartTime;

  if (phase == 0 && el >= NO_FLOW_TIME_MS) {
    phase = 1;
    phaseStartTime = now;
    Serial.println(F(">>> CPAP ON (60s)"));
  }
  else if (phase == 1 && el >= CPAP_TIME_MS) {
    phase = 2;
    Timer1.stop();
    digitalWrite(outPin, LOW);
    printResults();
    Serial.println(F("Done"));
    while (1) delay(1000);
  }

  int raw = analogRead(sensorPin);
  sensVal = alpha * raw + (1.0f - alpha) * sensVal;
  float rise = sensVal - preSensVal;

  if (phase == 0) {
    if (sensVal > noFlowMax) noFlowMax = sensVal;
  }
  else if (phase == 1 && rise > 0) {
    if (sensVal < flowMin) flowMin = sensVal;

    if (!inBreath) {
      inBreath = true;
      riseSum += rise;
      riseCount++;
    }
    if (rise <= 0.001f) inBreath = false;
  }

  preSensVal = sensVal;
  delay(10);
}

void pulseISR() {
  digitalWrite(outPin, LOW);
}

void printResults() {
  Serial.println(F("\n=== Results ==="));
  Serial.print(F("noFlowMax="));
  Serial.println(noFlowMax, 3);
  Serial.print(F("flowMin="));
  Serial.println(flowMin, 3);
  Serial.print(F("riseCount="));
  Serial.println(riseCount);

  if (riseCount > 0) {
    float avgRise = riseSum / riseCount;
    float zeroFlowThresh = (noFlowMax + flowMin) / 2.0;
    float riseThresh = avgRise * 0.5;
    if (riseThresh < 0.01) riseThresh = 0.01;

    Serial.println(F("\nCopy these into main code:"));
    Serial.print(F("const float zeroFlowThresh = "));
    Serial.print(zeroFlowThresh, 2);
    Serial.println(F(";"));

    Serial.print(F("const float riseThresh = "));
    Serial.print(riseThresh, 4);
    Serial.println(F(";"));
  } else {
    Serial.println(F("No breaths detected during CPAP."));
  }
}
