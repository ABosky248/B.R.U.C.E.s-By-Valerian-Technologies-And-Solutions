#include <TimerOne.h>

const int inPin = D2; //Digital input pin connected to the switch
const int sensorPin = A0;
const int outPin = 9;

float sensVal = 0;
float preSensVal = 0;

const float alpha = 0.01;
const float slopeThresh = 0.03;

void setup() {
  Serial.begin(9600);
  pinMode(outPin, OUTPUT);
  Timer1.initialize(50000);      // 20 Hz period
  Timer1.pwm(outPin, 7);         // about 0.7% duty on 0-1023 scale
}

void loop() {
  if (digitalRead(inPin) == LOW {
    digitalWrite(outPin, LOW);
    Serial.println("OFF");
    delay(10);
    return;
  }
  int raw = analogRead(sensorPin);
  sensVal = alpha * raw + (1 - alpha) * sensVal;
  float slope = sensVal - preSensVal;

  if (slope > slopeThresh) {
    Timer1.pwm(outPin, 7);
  } else {
    digitalWrite(outPin, LOW);
  }

  preSensVal = sensVal;
  Serial.println(raw);
  delay(10);
}
