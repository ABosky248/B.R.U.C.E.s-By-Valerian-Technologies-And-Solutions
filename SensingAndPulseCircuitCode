#include <TimerOne.h>

// ---- Pin definitions ----
const int sensorPin = A0;
const int outPin = 9;

// ---- Filtering ----
float sensVal = 0.0;
float preSensVal = 0.0;
const float alpha = 0.01;  // exponential moving average smoothing

// ---- Calibration values (replace with your calibrated values) ----
const float riseThresh = 0.0127;   // trigger when pressure rises by this much
const float zeroFlowThresh = 256; // sensor value above which there is CPAP flow
// ---------------------------------------------------------------

// ---- Pulse timing ----
const unsigned long pulsePeriodUs = 50000;   // 20 Hz -> 50,000 µs period
const unsigned long pulseWidthUs = 352;      // 352 µs pulse width

volatile bool pulseEnabled = false;          // true during inhale, false otherwise
volatile unsigned long pulseStateTime = 0;   // time when current pulse state started
volatile bool pulsePinHigh = false;          // current state of the pulse pin

void pulseISR() {
  unsigned long now = micros();
  unsigned long dt = now - pulseStateTime;

  if (!pulseEnabled) {
    // No pulse during exhalation or no flow: ensure LOW
    digitalWrite(outPin, LOW);
    pulsePinHigh = false;
    pulseStateTime = now;
    return;
  }

  if (pulsePinHigh) {
    // Pin is HIGH, check if pulse width elapsed
    if (dt >= pulseWidthUs) {
      digitalWrite(outPin, LOW);
      pulsePinHigh = false;
      pulseStateTime = now;
    }
  } else {
    // Pin is LOW, check if we need to start next pulse (period elapsed)
    if (dt >= pulsePeriodUs) {
      digitalWrite(outPin, HIGH);
      pulsePinHigh = true;
      pulseStateTime = now;
    }
  }
}

void setup() {
  Serial.begin(9600);
  pinMode(outPin, OUTPUT);
  digitalWrite(outPin, LOW);

  Timer1.initialize(pulsePeriodUs);  // 20 Hz period
  Timer1.attachInterrupt(pulseISR);
  Timer1.stop();  // stop until inhale is detected
}

void loop() {
  int raw = analogRead(sensorPin);

  // Low-pass filter to smooth sensor readings
  sensVal = alpha * raw + (1.0f - alpha) * sensVal;
  float rise = sensVal - preSensVal;  // positive on inhale

  // Conditions for inhale:
  // 1) There must be CPAP flow (sensor above zero-flow threshold)
  // 2) Pressure must be rising (positive rise)
  // 3) Rise must exceed the calibrated threshold
  bool inhaleDetected = (sensVal > zeroFlowThresh) && (rise > riseThresh) && (rise > 0.0f);

  if (inhaleDetected) {
    pulseEnabled = true;
    Timer1.start();
  } else {
    pulseEnabled = false;
    Timer1.stop();
    digitalWrite(outPin, LOW);  // ensure output is low during exhalation or no flow
  }

  preSensVal = sensVal;

  Serial.println(raw);
  delay(10);
}

